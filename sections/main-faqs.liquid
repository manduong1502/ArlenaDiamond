<div class="faqs-page full-width">
  <!-- Breadcrumbs -->
  <div class="faqs-breadcrumbs-container">
    <div class="faqs-breadcrumbs">
      <a href="/">HOME</a>
      <span>/</span>
      <span class="current">FREQUENTLY ASKED QUESTIONS</span>
    </div>
  </div>

  <!-- Hero Header -->
  <div class="faqs-hero">
    <span class="faqs-label">Customer Assistance</span>
    <h1 class="faqs-title">Frequently Asked Questions</h1>
    <div class="divider-diamond"><span></span></div>
    <p class="faqs-subtitle">Choosing fine jewellery is a personal experience. Whether you're selecting an engagement ring, celebrating a meaningful milestone or choosing a piece for yourself, we're here to make the process as considered and straightforward as possible. Below you'll find answers to some of our most frequently asked questions.</p>
    
    <!-- Search Bar -->
    <div class="faqs-search-wrapper">
      <div class="faqs-search-box">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input type="text" id="faq-search-input" placeholder="Search questions (e.g. ring size, delivery, warranty, diamonds)..." autocomplete="off">
        <button type="button" id="faq-search-clear" style="display: none;">&times;</button>
      </div>
    </div>
  </div>

  <div class="faqs-container">
    <!-- Category Filter Tabs -->
    <div class="faqs-categories">
      <button class="faq-tab active" data-category="all">All Questions</button>
      <button class="faq-tab" data-category="our-jewellery">Our Jewellery</button>
      <button class="faq-tab" data-category="ring-sizing">Ring Sizing</button>
      <button class="faq-tab" data-category="orders-customisation">Orders & Customisation</button>
      <button class="faq-tab" data-category="shipping-delivery">Shipping & Delivery</button>
      <button class="faq-tab" data-category="returns-exchanges">Returns & Exchanges</button>
      <button class="faq-tab" data-category="warranty-care">Warranty & Care</button>
    </div>

    <!-- Accordion List -->
    <div class="faqs-accordion" id="faqs-accordion-list">

      <!-- Group 1: OUR JEWELLERY -->
      <div class="faq-group" data-category="our-jewellery">
        <div class="faq-group-header">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#c5a880" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h12l4 6-10 12L2 9l4-6z"/>
            <path d="M11 3v18"/>
            <path d="M2 9h20"/>
          </svg>
          <h2 class="faq-group-title">Our Jewellery</h2>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Where is Arlena jewellery made?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Arlena jewellery is made to order in Australia, bringing together modern jewellery-making technology, skilled craftsmanship and more than 20 years of industry experience.</p>
            <p>Each piece is carefully finished and inspected before it leaves us.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Is every Arlena piece made to order?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes. Our jewellery is made to order rather than produced in large quantities.</p>
            <p>This allows each piece to be created according to your selected design, metal and available options, with careful attention throughout the production process.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>What metals do you offer?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Our designs are available in a selection of premium precious metals, including gold (Yellow Gold, White Gold, Rose Gold) and platinum, depending on the piece.</p>
            <p>Available metal options are shown on each product page.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Do you offer natural and lab grown diamonds?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Diamond options vary by design. Where natural or lab grown diamond options are available, they will be shown on the relevant product page.</p>
            <p>If you would like assistance choosing a diamond for your piece, please <a href="/pages/contact">contact us</a>.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Why are some diamond weights and quantities shown as “approx.”?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Some diamond weights, measurements and quantities may vary slightly depending on the individual stones, design requirements or selected ring size.</p>
            <p>Where this applies, we use “approx.” to provide a clear and transparent indication of the expected specification while allowing for these natural variations.</p>
          </div>
        </div>
      </div>

      <!-- Group 2: RING SIZING -->
      <div class="faq-group" data-category="ring-sizing">
        <div class="faq-group-header">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#c5a880" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v8"/>
            <path d="M8 12h8"/>
          </svg>
          <h2 class="faq-group-title">Ring Sizing</h2>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>How do I find my ring size?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Our <a href="/pages/ring-size-guide">Ring Size Guide</a> can help you determine the most suitable size before placing your order.</p>
            <p>For an engagement ring or other important purchase, we recommend having your finger professionally measured where possible for greater accuracy.</p>
            <p>If you're unsure about sizing, please <a href="/pages/contact">contact us</a> before placing your order and we'll be happy to assist.</p>
          </div>
        </div>
      </div>

      <!-- Group 3: ORDERS & CUSTOMISATION -->
      <div class="faq-group" data-category="orders-customisation">
        <div class="faq-group-header">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#c5a880" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          <h2 class="faq-group-title">Orders & Customisation</h2>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Can I customise an Arlena design?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Selected designs may be customised depending on the requested changes.</p>
            <p>If you're interested in a different metal, diamond specification, stone arrangement or another variation that isn't shown online, please <a href="/pages/contact">contact us</a> to discuss what may be possible.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Do you offer bespoke jewellery?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>If you're looking for something beyond the options available in our existing collection, please <a href="/pages/contact">contact us</a> to discuss your ideas.</p>
            <p>We'll let you know whether your requested design can be accommodated and guide you through the available options.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Can I change or cancel my order after placing it?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>As our jewellery is made to order, please <a href="/pages/contact">contact us</a> as soon as possible if you need to request a change or cancellation.</p>
            <p>Once production has commenced, changes or cancellations may not always be possible.</p>
          </div>
        </div>
      </div>

      <!-- Group 4: SHIPPING & DELIVERY -->
      <div class="faq-group" data-category="shipping-delivery">
        <div class="faq-group-header">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#c5a880" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
          <h2 class="faq-group-title">Shipping & Delivery</h2>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Do you offer free delivery?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes. We offer complimentary delivery in accordance with our <a href="/pages/shipping-delivery">Shipping & Delivery</a> terms.</p>
            <p>Orders are carefully packaged and sent using tracked delivery, with transit insurance arranged for eligible shipments in accordance with our delivery arrangements.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>How long will my order take?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>As our jewellery is made to order, production times may vary depending on the design and complexity of the piece.</p>
            <p>Estimated production and delivery information will be provided where applicable. If you require your jewellery for a particular date, we recommend <a href="/pages/contact">contacting us</a> before ordering so we can advise you on timing.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Can I track my order?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes. Once your order has been dispatched, tracking information will be provided so you can follow its delivery.</p>
          </div>
        </div>
      </div>

      <!-- Group 5: RETURNS & EXCHANGES -->
      <div class="faq-group" data-category="returns-exchanges">
        <div class="faq-group-header">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#c5a880" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/>
            <polyline points="23 20 23 14 17 14"/>
            <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
          </svg>
          <h2 class="faq-group-title">Returns & Exchanges</h2>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Can I return my jewellery?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Eligible standard made-to-order pieces may be returned within 30 days in accordance with our <a href="/pages/returns-exchanges">Returns & Exchanges Policy</a>.</p>
            <p>Return conditions and exclusions apply, and bespoke or personalised pieces may not be eligible for change-of-mind returns. Please refer to our <a href="/pages/returns-exchanges">Returns & Exchanges Policy</a> for full details before returning an item.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Can I exchange my jewellery?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Eligible pieces may be exchanged in accordance with our <a href="/pages/returns-exchanges">Returns & Exchanges Policy</a>.</p>
            <p>Please <a href="/pages/contact">contact us</a> before returning your jewellery so we can guide you through the process.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>What if there is a problem with my jewellery?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>If you believe your jewellery has a fault or manufacturing issue, please <a href="/pages/contact">contact us</a> as soon as possible.</p>
            <p>We'll assess the piece and assist you in accordance with our <a href="/pages/warranty">Limited Lifetime Warranty</a> and your rights under Australian Consumer Law.</p>
          </div>
        </div>
      </div>

      <!-- Group 6: WARRANTY & CARE -->
      <div class="faq-group" data-category="warranty-care">
        <div class="faq-group-header">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#c5a880" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <h2 class="faq-group-title">Warranty & Care</h2>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Does Arlena jewellery come with a warranty?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes. Arlena jewellery is supported by our <a href="/pages/warranty">Limited Lifetime Warranty</a> against eligible manufacturing defects, subject to the terms and exclusions of the warranty.</p>
            <p>Please refer to our <a href="/pages/warranty">Limited Lifetime Warranty page</a> for full details.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>How should I care for my Arlena jewellery?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Fine jewellery should be treated with care. We recommend removing your jewellery during activities that may expose it to impact, chemicals or unnecessary wear.</p>
            <p>When not being worn, store your jewellery carefully and separately to help protect it from scratches and damage.</p>
          </div>
        </div>
      </div>

      <!-- No Results Found Box (Hidden by default) -->
      <div id="faq-no-results" style="display: none; text-align: center; padding: 40px 20px; background: #fafaf9; border: 1px solid #eee; border-radius: 4px; margin-bottom: 30px;">
        <p style="font-size: 14px; color: #555; margin-bottom: 12px;">No matching questions found for your search.</p>
        <button type="button" id="faq-reset-search-btn" style="background: #111; color: #fff; border: none; padding: 8px 18px; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; border-radius: 2px;">View All Questions</button>
      </div>

    </div>

    <!-- Contact Support Card (Still have a question?) -->
    <div class="faqs-contact-box">
      <div class="contact-box-inner">
        <span class="contact-tag">Personal Concierge</span>
        <h3 class="contact-title">Still Have a Question?</h3>
        <p class="contact-subtitle">We're here to help.</p>
        <p class="contact-desc">If you have a question about a design, diamond, ring size, order or any aspect of your Arlena experience, please contact us and we'll be happy to assist.</p>
        <div class="contact-buttons-row">
          <a href="/pages/contact" class="btn-gold-contact">CONTACT US</a>
          <a href="mailto:hello@arlena.com.au" class="btn-outline-contact">EMAIL US</a>
        </div>
      </div>
    </div>
  </div>
</div>

