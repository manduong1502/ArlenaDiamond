<div class="faqs-page full-width">
  <div class="faqs-hero">
    <span class="faqs-label">Customer Concierge</span>
    <h1 class="faqs-title">Frequently Asked Questions</h1>
    <div class="divider-diamond"><span></span></div>
    <p class="faqs-subtitle">Find answers to common questions about our Australian made fine jewellery, made-to-order process, sizing, and delivery.</p>
  </div>

  <div class="faqs-container">
    <!-- Category Filter Tabs -->
    <div class="faqs-categories">
      <button class="faq-tab active" data-category="all">All Questions</button>
      <button class="faq-tab" data-category="ordering">Ordering & Craftsmanship</button>
      <button class="faq-tab" data-category="sizing">Sizing & Customisation</button>
      <button class="faq-tab" data-category="shipping">Shipping & Delivery</button>
      <button class="faq-tab" data-category="warranty">Warranty & Returns</button>
    </div>

    <!-- Accordion List -->
    <div class="faqs-accordion">

      <!-- Group 1: Ordering & Craftsmanship -->
      <div class="faq-group" data-category="ordering">
        <h3 class="faq-group-title">Ordering & Craftsmanship</h3>

        <div class="faq-item">
          <button class="faq-question">
            <span>Where is Arlena jewellery made?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Every Arlena piece is proudly made to order in Australia. Combining modern 3D jewellery-making technology with time-honoured handcraftsmanship, our Master Jeweller with over 20 years of experience oversees every single creation from raw metal casting to stone setting and final inspection.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>What does "Made to Order" mean for my purchase?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Rather than mass-producing jewellery in large factory quantities, your piece is individually created only after your order is placed. This allows us to select exceptional diamonds and precious metals tailored specifically to your chosen specifications, ensuring unmatched quality and attention to detail.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>How long does it take to craft my order?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Our standard crafting timeline is 2 to 3 weeks from order confirmation. Once your piece undergoes final quality inspection and certification, it is securely packaged in our signature luxury presentation box and dispatched via insured express delivery.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Are Arlena diamonds ethically sourced?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes. All diamonds, gemstones, and precious metals used by Arlena are 100% ethically sourced in compliance with the Kimberley Process certification scheme and strict environmental standards.</p>
          </div>
        </div>
      </div>

      <!-- Group 2: Sizing & Customisation -->
      <div class="faq-group" data-category="sizing">
        <h3 class="faq-group-title">Sizing & Customisation</h3>

        <div class="faq-item">
          <button class="faq-question">
            <span>How do I find my correct ring size?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>We recommend visiting our dedicated <a href="/pages/ring-size-guide">Ring Size Guide</a> page which provides international conversion charts (US, UK, EU) and measuring instructions. You can also request a complimentary ring sizer or visit a local jeweller to have your finger measured professionally.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Can I request a custom design or bespoke alteration?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Absolutely. Because every piece is made to order, our Master Jeweller can customize metal choices (18k Yellow Gold, White Gold, Rose Gold, Platinum), diamond specifications, engraving, or bespoke design modifications. Please contact us at <a href="mailto:hello@arlena.com.au">hello@arlena.com.au</a> to discuss your vision.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Can my ring be resized after purchase?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes. Most Arlena engagement rings and classic wedding bands can be resized by 1 to 2 sizes. We offer complimentary ring resizing within 30 days of delivery for standard designs. (Eternity bands with full pave setting may require remaking depending on design).</p>
          </div>
        </div>
      </div>

      <!-- Group 3: Shipping & Delivery -->
      <div class="faq-group" data-category="shipping">
        <h3 class="faq-group-title">Shipping & Delivery</h3>

        <div class="faq-item">
          <button class="faq-question">
            <span>Do you offer free insured shipping?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes! We provide complimentary fully insured express courier shipping across Australia for all orders. International shipping is also available with full transit insurance and signature on delivery.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>Will my delivery require a signature?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>For your security, all Arlena deliveries require an adult signature upon receipt. Parcels are packaged discretely without external brand logos to preserve surprise gifts and ensure safe transit.</p>
          </div>
        </div>
      </div>

      <!-- Group 4: Warranty & Returns -->
      <div class="faq-group" data-category="warranty">
        <h3 class="faq-group-title">Warranty & Returns</h3>

        <div class="faq-item">
          <button class="faq-question">
            <span>What warranty comes with Arlena jewellery?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Every piece of Arlena fine jewellery is backed by our Manufacturer Warranty covering any structural or craftsmanship defects. For complete terms, visit our <a href="/pages/warranty">Warranty</a> page.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            <span>What is your return & exchange policy?</span>
            <i class="fa-solid fa-plus faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>We offer 30-day returns and exchanges on eligible unworn items in original luxury packaging. Please review our <a href="/pages/returns-exchanges">Returns & Exchanges</a> page for full details and eligibility criteria.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Contact Support Box -->
    <div class="faqs-contact-box">
      <h4>Still have questions?</h4>
      <p>Our dedicated jewellery concierge is here to assist you with any questions or custom requests.</p>
      <a href="/pages/contact" class="btn-gold-contact">Contact Us</a>
    </div>
  </div>
</div>

<style>
  .faqs-page {
    background-color: #ffffff;
    color: #111111;
    min-height: 70vh;
  }

  /* Hero */
  .faqs-hero {
    background-color: #fdfaf6;
    padding: 90px 20px 60px;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .faqs-label {
    font-size: 11px;
    letter-spacing: 3px;
    color: #c5a880;
    text-transform: uppercase;
    font-weight: 600;
    display: block;
    margin-bottom: 12px;
  }
  .faqs-title {
    font-family: 'Cinzel', serif;
    font-size: 34px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 16px;
  }
  .divider-diamond {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin: 0 auto 20px;
  }
  .divider-diamond::before,
  .divider-diamond::after {
    content: '';
    display: block;
    width: 50px;
    height: 1px;
    background-color: #c5a880;
    opacity: 0.7;
  }
  .divider-diamond span {
    display: block;
    width: 5px;
    height: 5px;
    background-color: #c5a880;
    transform: rotate(45deg);
  }
  .faqs-subtitle {
    font-size: 13.5px;
    line-height: 1.6;
    color: #555555;
    max-width: 650px;
    margin: 0 auto;
  }

  /* Main Container */
  .faqs-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 20px 90px;
  }

  /* Filter Tabs */
  .faqs-categories {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 50px;
  }
  .faq-tab {
    background: #fdfaf6;
    border: 1px solid rgba(197, 168, 128, 0.3);
    padding: 10px 18px;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #444444;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .faq-tab.active,
  .faq-tab:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  /* Accordion Groups */
  .faq-group {
    margin-bottom: 45px;
  }
  .faq-group-title {
    font-family: 'Cinzel', serif;
    font-size: 18px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eeeeee;
  }

  /* Accordion Items */
  .faq-item {
    border-bottom: 1px solid #f0f0f0;
    margin-bottom: 10px;
  }
  .faq-question {
    width: 100%;
    background: none;
    border: none;
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    font-family: var(--font-base), sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #111111;
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .faq-question:hover {
    color: #c5a880;
  }
  .faq-icon {
    color: #c5a880;
    font-size: 12px;
    transition: transform 0.3s ease;
    margin-left: 15px;
    flex-shrink: 0;
  }
  .faq-item.open .faq-icon {
    transform: rotate(45deg);
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
  }
  .faq-item.open .faq-answer {
    max-height: 400px;
    padding-bottom: 18px;
  }
  .faq-answer p {
    font-size: 13px;
    line-height: 1.7;
    color: #555555;
    margin: 0;
  }
  .faq-answer a {
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Contact Support Box */
  .faqs-contact-box {
    background-color: #fdfaf6;
    border: 1px solid rgba(197, 168, 128, 0.3);
    padding: 40px;
    text-align: center;
    margin-top: 60px;
  }
  .faqs-contact-box h4 {
    font-family: 'Cinzel', serif;
    font-size: 20px;
    letter-spacing: 1px;
    color: #111111;
    margin-bottom: 10px;
  }
  .faqs-contact-box p {
    font-size: 13px;
    color: #666666;
    margin-bottom: 22px;
  }
  .btn-gold-contact {
    display: inline-block;
    background-color: #c5a880;
    color: #000000;
    padding: 12px 28px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .btn-gold-contact:hover {
    background-color: #111111;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .faqs-hero {
      padding: 60px 20px 40px;
    }
    .faqs-title {
      font-size: 26px;
    }
    .faqs-container {
      padding: 40px 20px 60px;
    }
    .faqs-contact-box {
      padding: 30px 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Accordion Toggle
    const faqQuestions = document.querySelectorAll('.faq-question');
    faqQuestions.forEach(function(question) {
      question.addEventListener('click', function() {
        const item = this.parentElement;
        item.classList.toggle('open');
      });
    });

    // Category Tabs Filter
    const tabs = document.querySelectorAll('.faq-tab');
    const groups = document.querySelectorAll('.faq-group');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        const cat = this.getAttribute('data-category');
        groups.forEach(function(group) {
          if (cat === 'all' || group.getAttribute('data-category') === cat) {
            group.style.display = 'block';
          } else {
            group.style.display = 'none';
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQs Page",
  "settings": []
}
{% endschema %}
