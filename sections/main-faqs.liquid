  @media (max-width: 991px) {
    .faqs-page {
      padding-top: 110px;
      padding-bottom: 60px;
    }
    .faqs-title {
      font-size: 26px;
    }
    .faqs-hero {
      padding: 40px 20px 35px;
    }
    .faq-group {
      padding: 20px 16px;
    }
    .faqs-contact-box {
      padding: 30px 20px;
    }
