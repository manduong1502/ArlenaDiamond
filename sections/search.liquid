<style>
  .grid-products-arlena {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 24px !important;
    padding: 0 60px 60px 60px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  @media (max-width: 991px) {
    .grid-products-arlena {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 16px !important;
      padding: 0 20px 40px 20px !important;
    }
  }
  .product-card-arlena {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .product-image-container {
    position: relative;
    aspect-ratio: 1/1;
    background-color: #fafaf9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .product-image-container a {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .product-image-container img.img-primary {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0;
    box-sizing: border-box;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.4s ease, transform 0.4s ease;
    opacity: 1;
    z-index: 1;
  }
  .product-image-container img.img-hover {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0;
    box-sizing: border-box;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.4s ease, transform 0.4s ease;
    opacity: 0;
    z-index: 2;
  }
  .product-card-arlena:hover .img-primary {
    opacity: 0;
  }
  .product-card-arlena:hover .img-hover {
    opacity: 1;
    transform: scale(1.04);
  }
  .product-quality-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #111;
    color: #fff;
    font-size: 8px;
    font-weight: 600;
    padding: 4px 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 10;
    border-radius: 2px;
  }
  .product-details-wrap {
    padding: 12px 0;
    text-align: left;
    display: block;
    text-decoration: none;
  }
  .product-image-container {
    position: relative;
    aspect-ratio: 1/1;
    background-color: #fafaf9;
    border: none;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .product-swatches {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    margin-bottom: 8px;
  }
  .swatch-dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    padding: 1.5px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .swatch-dot:hover {
    border-color: #666;
    transform: scale(1.2);
  }
  .swatch-dot.active {
    border-color: #111;
    transform: scale(1.15);
    box-shadow: 0 0 0 1px #111;
  }
  .swatch-dot-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block;
  }
  .product-title-text {
    font-size: 13px;
    font-weight: 400;
    color: #111;
    line-height: 1.5;
    height: 39px;
    overflow: hidden;
    display: block;
    margin-bottom: 8px;
    margin-top: 4px;
    transition: color 0.3s ease;
  }
  .product-card-arlena:hover .product-title-text {
    color: #c5a880;
  }
  .product-price-info {
    font-size: 14px;
    font-weight: 700;
    color: #111;
    display: flex;
    justify-content: flex-start;
    gap: 8px;
  }
  .product-compare-price {
    font-size: 12px;
    text-decoration: line-through;
    color: #888;
    font-weight: 400;
  }
</style>

<main class="main-collection full-width" style="background:#fff;">

  <!-- SEARCH HEADER -->
  <div class="collection-page-header" style="margin-top:80px; padding:20px 60px;">

    <!-- Breadcrumb -->
    <div style="font-size:11px; color:#999; margin-bottom:10px; text-transform:uppercase; letter-spacing:0.5px;">
      <a href="/" style="color:#999; text-decoration:none;">Home</a>
      <span style="margin:0 4px;">/</span>
      <span style="color:#111;">Search</span>
    </div>

    <!-- Title -->
    <div class="collection-main-title" style="font-size:20px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:16px; color:#111;">
      SEARCH RESULTS
    </div>

    {% assign clean_terms = search.terms | remove: '*' | escape %}

    <!-- Search bar -->
    <form action="{{ routes.search_url }}" method="get" role="search" id="arlena-search-form"
      style="border-bottom:1.5px solid #111; padding-bottom:10px; margin-bottom:18px; display:flex; align-items:center; gap:10px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" name="q" value="{{ clean_terms }}" placeholder="SEARCH BRANDS OR STYLE"
        style="flex:1; border:none; outline:none; font-size:14px; font-family:var(--font-base); background:none; text-transform:uppercase;" />
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
    </form>

    <!-- Count / Status -->
    {% if search.performed %}
      <div class="collection-controls-row" style="display:flex; justify-content:space-between; align-items:center;">
        <span class="product-count" style="font-size:12px; color:#999; text-transform:uppercase; letter-spacing:0.3px;">
          {% if search.results_count == 0 %}
            No results for "{{ clean_terms }}"
          {% else %}
            {{ search.results_count }} items found for "{{ clean_terms }}"
          {% endif %}
        </span>
      </div>
    {% endif %}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var forms = document.querySelectorAll('form[action*="/search"]');
      forms.forEach(function(form) {
        form.addEventListener('submit', function(e) {
          var input = form.querySelector('input[name="q"]');
          if (input && input.value.trim() !== '') {
            var val = input.value.trim().replace(/\*+$/, '');
            input.value = val + '*';
          }
        });
      });

      /* Swatch Color Image Preloader & Smooth Cross-dissolve Switching */
      var swatchDots = document.querySelectorAll('.swatch-dot');
      
      // Preload all swatch images into browser RAM cache instantly
      swatchDots.forEach(function(dot) {
        var pUrl = dot.getAttribute('data-color-primary');
        var hUrl = dot.getAttribute('data-color-hover');
        if (pUrl) { var i1 = new Image(); i1.src = pUrl; }
        if (hUrl) { var i2 = new Image(); i2.src = hUrl; }
      });

      swatchDots.forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var card = this.closest('.product-card-arlena');
          if (!card) return;
          
          var parentSwatches = this.closest('.product-swatches');
          if (parentSwatches) {
            parentSwatches.querySelectorAll('.swatch-dot').forEach(function(d) {
              d.classList.remove('active');
            });
          }
          this.classList.add('active');

          var primaryUrl = this.getAttribute('data-color-primary');
          var hoverUrl = this.getAttribute('data-color-hover');
          var primaryImg = card.querySelector('.img-primary');
          var hoverImg = card.querySelector('.img-hover');
          var imgContainer = card.querySelector('.product-image-container');

          if (imgContainer && primaryImg && primaryUrl) {
            // Smooth cross-dissolve fade
            imgContainer.style.opacity = '0.35';
            setTimeout(function() {
              if (primaryImg && primaryUrl) primaryImg.src = primaryUrl;
              if (hoverImg && hoverUrl) hoverImg.src = hoverUrl;
              imgContainer.style.opacity = '1';
            }, 90);
          } else {
            if (primaryImg && primaryUrl) primaryImg.src = primaryUrl;
            if (hoverImg && hoverUrl) hoverImg.src = hoverUrl;
          }
        });
      });
    });
  </script>

  <!-- PRODUCT GRID -->
  {% if search.performed and search.results_count > 0 %}
    <section class="grid-products-arlena" id="product-grid-container">
      {% for product in search.results %}
        {% if product.object_type == 'product' %}
          <div class="product-card-arlena">
            {%- comment -%} SMART COLOR IMAGE RESOLUTION (Independent Metal Matching) {%- endcomment -%}
            {%- assign rose_primary = nil -%}
            {%- assign rose_hover = nil -%}
            {%- assign yellow_primary = nil -%}
            {%- assign yellow_hover = nil -%}
            {%- assign white_primary = nil -%}
            {%- assign white_hover = nil -%}

            {%- comment -%} 1. Metafields (Skip Videos) {%- endcomment -%}
            {%- assign mf_rose = product.metafields.custom.media_rose_gold.value -%}
            {%- if mf_rose != blank -%}
              {%- for file in mf_rose -%}
                {%- assign f_type = file.media_type | default: file.mime_type | downcase -%}
                {%- assign f_url = file.url | downcase -%}
                {%- assign is_video = false -%}
                {%- if f_type contains 'video' or f_url contains '.mp4' or file.sources != blank -%}
                  {%- assign is_video = true -%}
                {%- endif -%}

                {%- unless is_video -%}
                  {%- assign img_u = nil -%}
                  {%- if file.preview_image -%}{%- assign img_u = file.preview_image | image_url: width: 600 -%}
                  {%- else -%}{%- assign img_u = file | image_url: width: 600 -%}{%- endif -%}
                  {%- if img_u != blank -%}
                    {%- if rose_primary == nil -%}{%- assign rose_primary = img_u -%}
                    {%- elsif rose_hover == nil -%}{%- assign rose_hover = img_u -%}{%- endif -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}

            {%- assign mf_yellow = product.metafields.custom.media_yellow_gold.value -%}
            {%- if mf_yellow != blank -%}
              {%- for file in mf_yellow -%}
                {%- assign f_type = file.media_type | default: file.mime_type | downcase -%}
                {%- assign f_url = file.url | downcase -%}
                {%- assign is_video = false -%}
                {%- if f_type contains 'video' or f_url contains '.mp4' or file.sources != blank -%}
                  {%- assign is_video = true -%}
                {%- endif -%}

                {%- unless is_video -%}
                  {%- assign img_u = nil -%}
                  {%- if file.preview_image -%}{%- assign img_u = file.preview_image | image_url: width: 600 -%}
                  {%- else -%}{%- assign img_u = file | image_url: width: 600 -%}{%- endif -%}
                  {%- if img_u != blank -%}
                    {%- if yellow_primary == nil -%}{%- assign yellow_primary = img_u -%}
                    {%- elsif yellow_hover == nil -%}{%- assign yellow_hover = img_u -%}{%- endif -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}

            {%- assign mf_white = product.metafields.custom.media_white_gold.value -%}
            {%- if mf_white != blank -%}
              {%- for file in mf_white -%}
                {%- assign f_type = file.media_type | default: file.mime_type | downcase -%}
                {%- assign f_url = file.url | downcase -%}
                {%- assign is_video = false -%}
                {%- if f_type contains 'video' or f_url contains '.mp4' or file.sources != blank -%}
                  {%- assign is_video = true -%}
                {%- endif -%}

                {%- unless is_video -%}
                  {%- assign img_u = nil -%}
                  {%- if file.preview_image -%}{%- assign img_u = file.preview_image | image_url: width: 600 -%}
                  {%- else -%}{%- assign img_u = file | image_url: width: 600 -%}{%- endif -%}
                  {%- if img_u != blank -%}
                    {%- if white_primary == nil -%}{%- assign white_primary = img_u -%}
                    {%- elsif white_hover == nil -%}{%- assign white_hover = img_u -%}{%- endif -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%} 2. Product Variants {%- endcomment -%}
            {%- for v in product.variants -%}
              {%- assign vt = v.title | downcase -%}
              {%- if v.featured_image -%}
                {%- assign v_img = v.featured_image | img_url: '600x' -%}
                {%- if rose_primary == nil and vt contains 'rose' -%}{%- assign rose_primary = v_img -%}{%- endif -%}
                {%- if yellow_primary == nil and vt contains 'yellow' -%}{%- assign yellow_primary = v_img -%}{%- endif -%}
                {%- if white_primary == nil and vt contains 'white' -%}{%- assign white_primary = v_img -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%} 3. Text Matching in Gallery Images & Alt {%- endcomment -%}
            {%- for img in product.images -%}
              {%- assign alt_lc = img.alt | downcase -%}
              {%- assign src_lc = img.src | downcase -%}

              {%- assign is_rose = false -%}
              {%- if alt_lc contains 'rose' or src_lc contains 'rose' -%}{%- assign is_rose = true -%}{%- endif -%}
              {%- if is_rose -%}
                {%- if rose_primary == nil -%}{%- assign rose_primary = img | img_url: '600x' -%}
                {%- elsif rose_hover == nil -%}{%- assign rose_hover = img | img_url: '600x' -%}{%- endif -%}
              {%- endif -%}

              {%- assign is_yellow = false -%}
              {%- if alt_lc contains 'yellow' or src_lc contains 'yellow' -%}{%- assign is_yellow = true -%}{%- endif -%}
              {%- if is_yellow -%}
                {%- if yellow_primary == nil -%}{%- assign yellow_primary = img | img_url: '600x' -%}
                {%- elsif yellow_hover == nil -%}{%- assign yellow_hover = img | img_url: '600x' -%}{%- endif -%}
              {%- endif -%}

              {%- assign is_white = false -%}
              {%- if alt_lc contains 'white' or src_lc contains 'white' -%}{%- assign is_white = true -%}{%- endif -%}
              {%- if is_white -%}
                {%- if white_primary == nil -%}{%- assign white_primary = img | img_url: '600x' -%}
                {%- elsif white_hover == nil -%}{%- assign white_hover = img | img_url: '600x' -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%} 4. Safe Independent Fallbacks {%- endcomment -%}
            {%- assign feat_img_url = product.featured_image | img_url: '600x' -%}
            {%- assign second_img_url = product.featured_image | img_url: '600x' -%}
            {%- if product.images[1] -%}{%- assign second_img_url = product.images[1] | img_url: '600x' -%}{%- endif -%}

            {%- unless rose_primary -%}{%- assign rose_primary = feat_img_url -%}{%- endunless -%}
            {%- unless rose_hover -%}{%- assign rose_hover = second_img_url -%}{%- endunless -%}

            {%- unless yellow_primary -%}{%- assign yellow_primary = feat_img_url -%}{%- endunless -%}
            {%- unless yellow_hover -%}{%- assign yellow_hover = second_img_url -%}{%- endunless -%}

            {%- unless white_primary -%}{%- assign white_primary = feat_img_url -%}{%- endunless -%}
            {%- unless white_hover -%}{%- assign white_hover = second_img_url -%}{%- endunless -%}

            {%- assign plat_primary = white_primary -%}
            {%- assign plat_hover = white_hover -%}

            <div class="product-image-container">
              {%- assign badge_text = "" -%}
              {%- for tag in product.tags -%}
                {%- assign tag_lc = tag | downcase -%}
                {%- if tag_lc contains 'lab-grown' or tag_lc contains 'lab grown' -%}
                  {%- assign badge_text = "LAB GROWN" -%}
                  {%- break -%}
                {%- elsif tag_lc contains 'best' or tag_lc contains 'hot' -%}
                  {%- assign badge_text = "BEST SELLER" -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if badge_text != "" -%}
                <span class="product-quality-badge">{{ badge_text }}</span>
              {%- endif -%}

              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img src="{{ rose_primary }}" class="img-primary" alt="{{ product.title | escape }}">
                  <img src="{{ rose_hover }}" class="img-hover" alt="{{ product.title | escape }}">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                {% endif %}
              </a>
            </div>

            <div class="product-swatches" style="padding: 8px 0 4px 0;">
              <div class="swatch-dot active" title="Rose Gold" data-color-primary="{{ rose_primary }}" data-color-hover="{{ rose_hover }}">
                <span class="swatch-dot-inner" style="background-color: #e0b39f;"></span>
              </div>
              <div class="swatch-dot" title="Yellow Gold" data-color-primary="{{ yellow_primary }}" data-color-hover="{{ yellow_hover }}">
                <span class="swatch-dot-inner" style="background-color: #e5d0a4;"></span>
              </div>
              <div class="swatch-dot" title="White Gold" data-color-primary="{{ white_primary }}" data-color-hover="{{ white_hover }}">
                <span class="swatch-dot-inner" style="background-color: #e2e2e2;"></span>
              </div>
              <div class="swatch-dot" title="Platinum" data-color-primary="{{ plat_primary }}" data-color-hover="{{ plat_hover }}">
                <span class="swatch-dot-inner" style="background-color: #dfdfdf;"></span>
              </div>
            </div>

            <a href="{{ product.url }}" class="product-details-wrap" style="padding-top: 4px;">

              <span class="product-title-text">{{ product.title }}</span>
              
              <div class="product-price-info">
                {% if product.compare_at_price > product.price %}
                  <span class="product-compare-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  <span style="color:#e8000d;">From {{ product.price | money_without_trailing_zeros }}</span>
                {% else %}
                  <span>From {{ product.price | money_without_trailing_zeros }}</span>
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% elsif search.performed %}
    <div style="text-align:center; padding:80px 20px; font-family:var(--font-base);">
      <p style="font-size:16px; color:#888; margin-bottom:24px;">No products found for "{{ clean_terms }}"</p>
      <a href="/collections/all" style="background:#111; color:#fff; padding:14px 32px; text-decoration:none; font-size:12px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase;">CONTINUE SHOPPING</a>
    </div>
  {% endif %}

</main>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}}
