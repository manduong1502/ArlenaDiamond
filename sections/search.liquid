<style>
  .grid-products-arlena {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 24px !important;
    padding: 0 60px 60px 60px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  @media (max-width: 991px) {
    .grid-products-arlena {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 16px !important;
      padding: 0 20px 40px 20px !important;
    }
  }
  .product-card-arlena {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .product-image-container {
    position: relative;
    aspect-ratio: 1/1;
    background-color: #fafaf9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .product-image-container a {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .product-image-container img.img-primary {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0;
    box-sizing: border-box;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.4s ease, transform 0.4s ease;
    opacity: 1;
    z-index: 1;
  }
  .product-image-container img.img-hover {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0;
    box-sizing: border-box;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.4s ease, transform 0.4s ease;
    opacity: 0;
    z-index: 2;
  }
  .product-card-arlena:hover .img-primary {
    opacity: 0;
  }
  .product-card-arlena:hover .img-hover {
    opacity: 1;
    transform: scale(1.04);
  }
  .product-quality-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #111;
    color: #fff;
    font-size: 8px;
    font-weight: 600;
    padding: 4px 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 10;
    border-radius: 2px;
  }
  .product-details-wrap {
    padding: 12px 0;
    text-align: left;
    display: block;
    text-decoration: none;
  }
  .product-swatches {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    margin-bottom: 8px;
  }
  .swatch-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid #ddd;
    padding: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .swatch-dot:hover {
    border-color: #999;
  }
  .swatch-dot.active {
    border-color: #111;
  }
  .swatch-dot-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block;
  }
  .product-title-text {
    font-size: 13px;
    font-weight: 400;
    color: #111;
    line-height: 1.5;
    height: 39px;
    overflow: hidden;
    display: block;
    margin-bottom: 8px;
    margin-top: 4px;
    transition: color 0.3s ease;
  }
  .product-card-arlena:hover .product-title-text {
    color: #c5a880;
  }
  .product-price-info {
    font-size: 14px;
    font-weight: 700;
    color: #111;
    display: flex;
    justify-content: flex-start;
    gap: 8px;
  }
  .product-compare-price {
    font-size: 12px;
    text-decoration: line-through;
    color: #888;
    font-weight: 400;
  }
</style>

<main class="main-collection full-width" style="background:#fff;">

  <!-- SEARCH HEADER -->
  <div class="collection-page-header" style="margin-top:80px; padding:20px 60px;">

    <!-- Breadcrumb -->
    <div style="font-size:11px; color:#999; margin-bottom:10px; text-transform:uppercase; letter-spacing:0.5px;">
      <a href="/" style="color:#999; text-decoration:none;">Home</a>
      <span style="margin:0 4px;">/</span>
      <span style="color:#111;">Search</span>
    </div>

    <!-- Title -->
    <div class="collection-main-title" style="font-size:20px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:16px; color:#111;">
      SEARCH RESULTS
    </div>

    {% assign clean_terms = search.terms | remove: '*' | escape %}

    <!-- Search bar -->
    <form action="{{ routes.search_url }}" method="get" role="search" id="arlena-search-form"
      style="border-bottom:1.5px solid #111; padding-bottom:10px; margin-bottom:18px; display:flex; align-items:center; gap:10px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" name="q" value="{{ clean_terms }}" placeholder="SEARCH BRANDS OR STYLE"
        style="flex:1; border:none; outline:none; font-size:14px; font-family:var(--font-base); background:none; text-transform:uppercase;" />
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
    </form>

    <!-- Count / Status -->
    {% if search.performed %}
      <div class="collection-controls-row" style="display:flex; justify-content:space-between; align-items:center;">
        <span class="product-count" style="font-size:12px; color:#999; text-transform:uppercase; letter-spacing:0.3px;">
          {% if search.results_count == 0 %}
            No results for "{{ clean_terms }}"
          {% else %}
            {{ search.results_count }} items found for "{{ clean_terms }}"
          {% endif %}
        </span>
      </div>
    {% endif %}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var forms = document.querySelectorAll('form[action*="/search"]');
      forms.forEach(function(form) {
        form.addEventListener('submit', function(e) {
          var input = form.querySelector('input[name="q"]');
          if (input && input.value.trim() !== '') {
            var val = input.value.trim().replace(/\*+$/, '');
            input.value = val + '*';
          }
        });
      });

      var swatchDots = document.querySelectorAll('.swatch-dot');
      swatchDots.forEach(function(dot) {
        var handler = function(e) {
          e.preventDefault();
          e.stopPropagation();
          var card = this.closest('.product-card-arlena');
          if (!card) return;
          var parentSwatches = this.closest('.product-swatches');
          if (parentSwatches) {
            parentSwatches.querySelectorAll('.swatch-dot').forEach(function(d) {
              d.classList.remove('active');
            });
          }
          this.classList.add('active');
          var newImg = this.getAttribute('data-color-img');
          if (newImg && newImg !== '') {
            var primaryImg = card.querySelector('.img-primary');
            if (primaryImg) {
              primaryImg.src = newImg;
            }
          }
        };
        dot.addEventListener('mouseenter', handler);
        dot.addEventListener('click', handler);
      });
    });
  </script>

  <!-- PRODUCT GRID -->
  {% if search.performed and search.results_count > 0 %}
    <section class="grid-products-arlena" id="product-grid-container">
      {% for product in search.results %}
        {% if product.object_type == 'product' %}
          <div class="product-card-arlena">
            <div class="product-image-container">
              {%- assign badge_text = "" -%}
              {%- for tag in product.tags -%}
                {%- assign tag_lc = tag | downcase -%}
                {%- if tag_lc contains 'lab-grown' or tag_lc contains 'lab grown' -%}
                  {%- assign badge_text = "LAB GROWN" -%}
                  {%- break -%}
                {%- elsif tag_lc contains 'best' or tag_lc contains 'hot' -%}
                  {%- assign badge_text = "BEST SELLER" -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if badge_text != "" -%}
                <span class="product-quality-badge">{{ badge_text }}</span>
              {%- endif -%}

              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x' }}" class="img-primary" alt="{{ product.title | escape }}">
                  {% if product.images[1] %}
                    <img src="{{ product.images[1] | img_url: '600x' }}" class="img-hover" alt="{{ product.title | escape }}">
                  {% endif %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                {% endif %}
              </a>
            </div>

            <a href="{{ product.url }}" class="product-details-wrap">
              {%- comment -%} SMART COLOR IMAGE RESOLUTION (Metafields, Variants, Alt, Filenames) {%- endcomment -%}
              {%- assign yellow_img = nil -%}
              {%- assign rose_img = nil -%}
              {%- assign white_img = nil -%}
              {%- assign plat_img = nil -%}

              {%- comment -%} 1. Metafields {%- endcomment -%}
              {%- assign mf_yellow = product.metafields.custom.media_yellow_gold.value.first -%}
              {%- if mf_yellow -%}
                {%- if mf_yellow.preview_image -%}
                  {%- assign yellow_img = mf_yellow.preview_image | image_url: width: 600 -%}
                {%- else -%}
                  {%- assign yellow_img = mf_yellow | image_url: width: 600 -%}
                {%- endif -%}
              {%- endif -%}

              {%- assign mf_rose = product.metafields.custom.media_rose_gold.value.first -%}
              {%- if mf_rose -%}
                {%- if mf_rose.preview_image -%}
                  {%- assign rose_img = mf_rose.preview_image | image_url: width: 600 -%}
                {%- else -%}
                  {%- assign rose_img = mf_rose | image_url: width: 600 -%}
                {%- endif -%}
              {%- endif -%}

              {%- assign mf_white = product.metafields.custom.media_white_gold.value.first -%}
              {%- if mf_white -%}
                {%- if mf_white.preview_image -%}
                  {%- assign white_img = mf_white.preview_image | image_url: width: 600 -%}
                {%- else -%}
                  {%- assign white_img = mf_white | image_url: width: 600 -%}
                {%- endif -%}
              {%- endif -%}

              {%- comment -%} 2. Variants {%- endcomment -%}
              {%- for v in product.variants -%}
                {%- assign v_title = v.title | downcase -%}
                {%- if yellow_img == nil and v_title contains 'yellow' and v.featured_image -%}
                  {%- assign yellow_img = v.featured_image | img_url: '600x' -%}
                {%- endif -%}
                {%- if rose_img == nil and v_title contains 'rose' and v.featured_image -%}
                  {%- assign rose_img = v.featured_image | img_url: '600x' -%}
                {%- endif -%}
                {%- if white_img == nil and v_title contains 'white' and v.featured_image -%}
                  {%- assign white_img = v.featured_image | img_url: '600x' -%}
                {%- endif -%}
                {%- if plat_img == nil and v_title contains 'plat' and v.featured_image -%}
                  {%- assign plat_img = v.featured_image | img_url: '600x' -%}
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} 3. Gallery Images (alt or filename) {%- endcomment -%}
              {%- for img in product.images -%}
                {%- assign alt_lc = img.alt | downcase -%}
                {%- assign src_lc = img.src | downcase -%}
                {%- if yellow_img == nil -%}
                  {%- if alt_lc contains 'yellow' or src_lc contains 'yellow' -%}
                    {%- assign yellow_img = img | img_url: '600x' -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if rose_img == nil -%}
                  {%- if alt_lc contains 'rose' or src_lc contains 'rose' -%}
                    {%- assign rose_img = img | img_url: '600x' -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if white_img == nil -%}
                  {%- if alt_lc contains 'white' or src_lc contains 'white' -%}
                    {%- assign white_img = img | img_url: '600x' -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} Fallbacks to featured image {%- endcomment -%}
              {%- assign feat_img_url = product.featured_image | img_url: '600x' -%}
              {%- assign feat_src_lc = product.featured_image.src | downcase -%}
              {%- assign feat_alt_lc = product.featured_image.alt | downcase -%}

              {%- unless yellow_img -%}{%- assign yellow_img = feat_img_url -%}{%- endunless -%}
              {%- unless rose_img -%}{%- assign rose_img = feat_img_url -%}{%- endunless -%}
              {%- unless white_img -%}{%- assign white_img = feat_img_url -%}{%- endunless -%}
              {%- unless plat_img -%}{%- assign plat_img = white_img -%}{%- endunless -%}

              {%- comment -%} Determine initial active color based on featured image {%- endcomment -%}
              {%- assign active_color = 'yellow' -%}
              {%- if feat_src_lc contains 'rose' or feat_alt_lc contains 'rose' -%}
                {%- assign active_color = 'rose' -%}
              {%- elsif feat_src_lc contains 'white' or feat_alt_lc contains 'white' -%}
                {%- assign active_color = 'white' -%}
              {%- elsif feat_src_lc contains 'yellow' or feat_alt_lc contains 'yellow' -%}
                {%- assign active_color = 'yellow' -%}
              {%- endif -%}

              <div class="product-swatches">
                <div class="swatch-dot {% if active_color == 'yellow' %}active{% endif %}" title="Yellow Gold" data-color-img="{{ yellow_img }}">
                  <span class="swatch-dot-inner" style="background-color: #e5d0a4;"></span>
                </div>
                <div class="swatch-dot {% if active_color == 'rose' %}active{% endif %}" title="Rose Gold" data-color-img="{{ rose_img }}">
                  <span class="swatch-dot-inner" style="background-color: #e0b39f;"></span>
                </div>
                <div class="swatch-dot {% if active_color == 'white' %}active{% endif %}" title="White Gold" data-color-img="{{ white_img }}">
                  <span class="swatch-dot-inner" style="background-color: #e2e2e2;"></span>
                </div>
                <div class="swatch-dot {% if active_color == 'platinum' %}active{% endif %}" title="Platinum" data-color-img="{{ plat_img }}">
                  <span class="swatch-dot-inner" style="background-color: #dfdfdf;"></span>
                </div>
              </div>

              <span class="product-title-text">{{ product.title }}</span>
              
              <div class="product-price-info">
                {% if product.compare_at_price > product.price %}
                  <span class="product-compare-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  <span style="color:#e8000d;">{{ product.price | money_without_trailing_zeros }}</span>
                {% else %}
                  <span>{{ product.price | money_without_trailing_zeros }}</span>
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% elsif search.performed %}
    <div style="text-align:center; padding:80px 20px; font-family:var(--font-base);">
      <p style="font-size:16px; color:#888; margin-bottom:24px;">No products found for "{{ clean_terms }}"</p>
      <a href="/collections/all" style="background:#111; color:#fff; padding:14px 32px; text-decoration:none; font-size:12px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase;">CONTINUE SHOPPING</a>
    </div>
  {% endif %}

</main>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}}
