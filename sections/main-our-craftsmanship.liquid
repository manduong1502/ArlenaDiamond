<div class="craftsmanship-page full-width">
  <!-- 1. HERO BANNER -->
  <section class="craftsmanship-hero">
    <div class="craftsmanship-hero-bg"></div>
    <div class="craftsmanship-hero-content">
      <span class="craftsmanship-label">Our Craftsmanship</span>
      <h1 class="craftsmanship-hero-title">Crafted with Experience and Precision</h1>
      <div class="craftsmanship-hero-text">
        <p>At Arlena, every piece begins with a commitment to quality, precision and timeless design. Each item is made to order in Australia, combining modern jewellery-making technology with traditional craftsmanship to create jewellery that is uniquely yours.</p>
        <p>Our Master Jeweller, with more than 20 years of experience, oversees the skilled craftsmanship behind every piece. From the first design through to the final inspection, every detail is carefully considered to ensure exceptional quality and lasting beauty.</p>
        <p>Because every piece is individually made, we never mass produce our jewellery. Each creation is crafted with care, patience and attention to detail before it becomes part of your story.</p>
      </div>
    </div>
  </section>

  <!-- 2. CRAFTSMANSHIP PROCESS -->
  <section class="craftsmanship-process">
    <div class="process-header">
      <h2 class="process-title">Our Craftsmanship Process</h2>
      <div class="divider-diamond"><span></span></div>
    </div>

    <div class="process-list">
      <!-- Step 01 -->
      <div class="process-item">
        <div class="process-text-col">
          <span class="process-num">01</span>
          <h3 class="process-step-title">Design & Stone Selection</h3>
          <p class="process-step-desc">Every piece begins with thoughtful design and carefully selected diamonds, gemstones and precious metals chosen for their beauty, quality and durability.</p>
        </div>
        <div class="process-img-col">
          <img src="{{ 'sub_classic.png' | asset_url }}" alt="Design and Stone Selection" loading="lazy">
        </div>
      </div>

      <!-- Step 02 -->
      <div class="process-item process-reverse">
        <div class="process-text-col">
          <span class="process-num">02</span>
          <h3 class="process-step-title">Precision Manufacturing</h3>
          <p class="process-step-desc">Using advanced jewellery-making technology, each design is accurately produced before being expertly finished by hand where craftsmanship matters most.</p>
        </div>
        <div class="process-img-col">
          <img src="{{ 'sub_side_stones.png' | asset_url }}" alt="Precision Manufacturing" loading="lazy">
        </div>
      </div>

      <!-- Step 03 -->
      <div class="process-item">
        <div class="process-text-col">
          <span class="process-num">03</span>
          <h3 class="process-step-title">Master Craftsmanship</h3>
          <p class="process-step-desc">Our Master Jeweller personally oversees the skilled craftsmanship of every piece, including stone setting, finishing and final quality inspection.</p>
        </div>
        <div class="process-img-col">
          <img src="{{ 'moments_ring_hand.png' | asset_url }}" alt="Master Craftsmanship" loading="lazy">
        </div>
      </div>

      <!-- Step 04 -->
      <div class="process-item process-reverse">
        <div class="process-text-col">
          <span class="process-num">04</span>
          <h3 class="process-step-title">Final Quality Inspection</h3>
          <p class="process-step-desc">Before your jewellery leaves our workshop, every detail is carefully inspected to ensure it meets our quality standards.</p>
        </div>
        <div class="process-img-col">
          <img src="{{ 'sub_infinity.png' | asset_url }}" alt="Final Quality Inspection" loading="lazy">
        </div>
      </div>

      <!-- Step 05 -->
      <div class="process-item">
        <div class="process-text-col">
          <span class="process-num">05</span>
          <h3 class="process-step-title">Made for You</h3>
          <p class="process-step-desc">Your jewellery is carefully cleaned, beautifully presented and prepared for its journey to you, ready to celebrate life's most meaningful moments.</p>
        </div>
        <div class="process-img-col">
          <img src="{{ 'moments_ring_box.png' | asset_url }}" alt="Made for You" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- 3. WHY CHOOSE ARLENA -->
  <section class="craftsmanship-why">
    <div class="why-header">
      <h2 class="why-title">Why Choose Arlena</h2>
      <div class="divider-diamond-dark"><span></span></div>
    </div>

    <div class="why-grid">
      <!-- Item 1: Australian Made -->
      <div class="why-card">
        <div class="why-icon">
          <svg viewBox="0 0 80 80" width="38" height="38" fill="none" stroke="#c5a880" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 16 30 C 18 25 22.5 22 27.5 20 C 31.5 19 34.5 20 37.5 16 C 39.5 13 42.5 9.5 45.5 9.5 C 48 9.5 49 12.5 48 16 C 50.5 18 53 17 55 15 C 56 12 57.5 7 59.5 5 C 60.7 7.5 62 13.5 63.5 17.5 C 66.5 22.5 71.5 28.5 72.5 35.5 C 73 42.5 69.5 49.5 66 54.5 C 62.5 58 57.5 58 53.5 54.5 C 50.5 51.5 48 49 44.5 50.5 C 41 52 35.5 52.5 30.5 53.5 C 25 55 20 56 16 51.5 C 13 47.5 13 36.5 16 30 Z"/>
            <path d="M 56 63 C 58.5 62 61 63 60.5 65.5 C 60 68 57.5 70 56 68.5 C 54.5 67 54.5 64 56 63 Z"/>
          </svg>
        </div>
        <h4>Australian Made</h4>
        <p>Every piece is proudly made to order in Australia.</p>
      </div>

      <!-- Item 2: Master Expertise -->
      <div class="why-card">
        <div class="why-icon">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="#c5a880" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><line x1="14.5" y1="14.5" x2="20" y2="20"/><path d="M8 10l2-2 2 2-2 2-2-2z"/></svg>
        </div>
        <h4>Master Expertise</h4>
        <p>Guided by our Master Jeweller with more than 20 years of experience.</p>
      </div>

      <!-- Item 3: Carefully Selected Materials -->
      <div class="why-card">
        <div class="why-icon">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="#c5a880" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9l4-6z"/><path d="M11 3v18"/><path d="M2 9h20"/></svg>
        </div>
        <h4>Carefully Selected Materials</h4>
        <p>Quality diamonds, gemstones and precious metals chosen for beauty and durability.</p>
      </div>

      <!-- Item 4: Made to Order -->
      <div class="why-card">
        <div class="why-icon">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="#c5a880" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <h4>Made to Order</h4>
        <p>Every piece is individually crafted for you—never mass produced.</p>
      </div>
    </div>
  </section>

  <!-- 4. MADE WITH PURPOSE -->
  <section class="craftsmanship-promise">
    <div class="promise-container">
      <div class="promise-text-col">
        <span class="section-label">Made with Purpose</span>
        <h2 class="promise-title">Made with Purpose</h2>
        <p class="promise-lead">At Arlena, we believe jewellery should be more than beautiful—it should be meaningful. Every piece we create represents a moment, a memory and a story that deserves exceptional craftsmanship.</p>
        <p class="promise-body">From the workshop to the moment it reaches you, our promise is simple: thoughtful design, meticulous craftsmanship and uncompromising quality.</p>
      </div>
      <div class="promise-img-col">
        <img src="{{ 'Engagement Rings.jpg' | asset_url }}" alt="Arlena Made with Purpose Solitaire Diamond Ring" loading="lazy">
      </div>
    </div>
  </section>
</div>

<style>
  .craftsmanship-page {
    background-color: #ffffff;
    color: #111111;
  }

  /* ═══ 1. HERO BANNER ═══ */
  .craftsmanship-hero {
    position: relative;
    width: 100%;
    min-height: 580px;
    background-color: #0b0b0b;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 130px;
    box-sizing: border-box;
  }
  .craftsmanship-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.7) 45%, rgba(0,0,0,0.2) 100%), url('{{ 'handcraft_jewelry.png' | asset_url }}');
    background-size: cover;
    background-position: right center;
    z-index: 1;
  }
  .craftsmanship-hero-content {
    position: relative;
    z-index: 2;
    max-width: 650px;
    padding: 60px 40px 80px 80px;
    color: #ffffff;
  }
  .craftsmanship-label {
    font-size: 11px;
    letter-spacing: 2px;
    color: #c5a880;
    text-transform: uppercase;
    font-weight: 600;
    display: block;
    margin-bottom: 12px;
  }
  .craftsmanship-hero-title {
    font-family: 'Cinzel', serif;
    font-size: 34px;
    letter-spacing: 1.5px;
    line-height: 1.25;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 22px;
  }
  .craftsmanship-hero-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .craftsmanship-hero-text p {
    font-size: 13px;
    line-height: 1.7;
    color: #d0d0d0;
    margin: 0;
  }

  /* ═══ 2. PROCESS SECTION ═══ */
  .craftsmanship-process {
    background-color: #fdfaf6;
    padding: 95px 40px;
  }
  .process-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .process-title {
    font-family: 'Cinzel', serif;
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 12px;
  }
  .divider-diamond {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }
  .divider-diamond::before,
  .divider-diamond::after {
    content: '';
    display: block;
    width: 60px;
    height: 1px;
    background-color: #c5a880;
    opacity: 0.7;
  }
  .divider-diamond span {
    display: block;
    width: 6px;
    height: 6px;
    background-color: #c5a880;
    transform: rotate(45deg);
  }
  .process-list {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }
  .process-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 240px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .process-item:last-child {
    border-bottom: none;
  }
  .process-item.process-reverse .process-text-col {
    order: 2;
  }
  .process-item.process-reverse .process-img-col {
    order: 1;
  }
  .process-text-col {
    padding: 40px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .process-num {
    font-family: 'Cinzel', serif;
    font-size: 32px;
    color: #c5a880;
    font-weight: 300;
    margin-bottom: 10px;
    display: block;
  }
  .process-step-title {
    font-family: 'Cinzel', serif;
    font-size: 16px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 12px;
  }
  .process-step-desc {
    font-size: 12.5px;
    line-height: 1.65;
    color: #555555;
    margin: 0;
  }
  .process-img-col {
    height: 100%;
    min-height: 240px;
    overflow: hidden;
    background-color: #f5f0ea;
  }
  .process-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .process-img-col:hover img {
    transform: scale(1.04);
  }

  /* ═══ 3. WHY CHOOSE ARLENA ═══ */
  .craftsmanship-why {
    background-color: #000000;
    color: #ffffff;
    padding: 95px 40px;
    text-align: center;
  }
  .why-header {
    margin-bottom: 60px;
  }
  .why-title {
    font-family: 'Cinzel', serif;
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 12px;
  }
  .divider-diamond-dark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }
  .divider-diamond-dark::before,
  .divider-diamond-dark::after {
    content: '';
    display: block;
    width: 60px;
    height: 1px;
    background-color: #c5a880;
    opacity: 0.7;
  }
  .divider-diamond-dark span {
    display: block;
    width: 6px;
    height: 6px;
    background-color: #c5a880;
    transform: rotate(45deg);
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .why-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 10px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }
  .why-card:last-child {
    border-right: none;
  }
  .why-icon {
    margin-bottom: 20px;
  }
  .why-card h4 {
    font-family: 'Cinzel', serif;
    font-size: 12.5px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 12px;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .why-card p {
    font-size: 11.5px;
    line-height: 1.6;
    color: #b0b0b0;
    margin: 0;
  }

  /* ═══ 4. OUR PROMISE ═══ */
  .craftsmanship-promise {
    background-color: #fdfaf6;
    padding: 95px 40px;
  }
  .promise-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .promise-text-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .promise-title {
    font-family: 'Cinzel', serif;
    font-size: 26px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #111111;
    margin: 0;
  }
  .promise-lead {
    font-size: 14px;
    line-height: 1.6;
    color: #111111;
    font-weight: 500;
    margin: 0;
  }
  .promise-body {
    font-size: 12.5px;
    line-height: 1.7;
    color: #555555;
    margin: 0;
  }
  .promise-img-col {
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  }
  .promise-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 991px) {
    .craftsmanship-hero {
      padding-top: 100px;
      min-height: auto;
    }
    .craftsmanship-hero-content {
      padding: 40px 24px 60px 24px;
      max-width: 100%;
    }
    .craftsmanship-hero-title {
      font-size: 26px;
    }
    .process-item,
    .process-item.process-reverse {
      grid-template-columns: 1fr;
    }
    .process-item.process-reverse .process-text-col {
      order: 1;
    }
    .process-item.process-reverse .process-img-col {
      order: 2;
    }
    .process-text-col {
      padding: 30px 20px;
    }
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }
    .why-card {
      border-right: none;
    }
    .promise-container {
      grid-template-columns: 1fr;
      gap: 35px;
    }
  }
</style>

{% schema %}
{
  "name": "Our Craftsmanship",
  "settings": []
}
{% endschema %}
